# Raspberry Pi gateway configuration — copy to .env and edit.
# Loaded by the systemd unit (pi_gateway.service → EnvironmentFile).

# --- local field broker (where ESP32 nodes publish) ---
LOCAL_BROKER_HOST=localhost
LOCAL_BROKER_PORT=1883
LOCAL_TOPIC=esp32/+/data

# --- cloud destination: MQTT broker ---
CLOUD_BROKER_HOST=mqtt.cloud.example.com
CLOUD_BROKER_PORT=1883
# The broker user is also the tenant namespace: this gateway only publishes to
# shm/ingest/<CLOUD_USER>/data (mosquitto ACL pattern shm/ingest/%u/#). Give
# each field gateway its own broker user for isolated tenants.
CLOUD_USER=shm-gateway
CLOUD_PASS=shm-gateway-pass
CLOUD_TLS=false
# Defaults to shm/ingest/<CLOUD_USER>/data if unset:
CLOUD_TOPIC=shm/ingest/shm-gateway/data

# --- cloud destination: REST fallback (optional) ---
# BACKEND_URL=https://cloud.example.com/api/beamDeviceData
# IOT_API_KEY=change-me-to-random-value

# --- logging ---
# GATEWAY_LOG_FILE=/var/log/shm_gateway.log