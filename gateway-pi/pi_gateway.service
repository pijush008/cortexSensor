[Unit]
Description=SHM Raspberry Pi gateway (field → cloud)
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/shm/gateway-pi
ExecStart=/usr/bin/python3 /home/pi/shm/gateway-pi/pi_gateway.py
Restart=always
RestartSec=10
# EnvironmentFromFile? No — use an EnvironmentFile for secrets:
EnvironmentFile=/home/pi/shm/gateway-pi/.env
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target