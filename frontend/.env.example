# Base URL of the API, as the BROWSER reaches it.
#
# Development: the API directly. `npm run dev` starts it on 3001.
NEXT_PUBLIC_API_URL=http://localhost:3001/api
#
# Production: leave it EMPTY. The browser then calls the relative /api, which
# nginx routes to the backend on the same origin. docker-compose.prod.yml
# already bakes "" into the image; an absolute URL here would pin one hostname
# into the bundle and break every other.
