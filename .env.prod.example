# Production environment for docker-compose.prod.yml.
#
# Copy to .env.prod on the server and fill in. .env.prod is gitignored and must
# stay that way — it holds the database password, the Supabase service-role key
# and the JWT signing secrets.
#
#   cp .env.prod.example .env.prod && $EDITOR .env.prod
#
# A value containing "#" must be QUOTED, or everything from the # is read as a
# comment. The Supabase password is the usual casualty; percent-encode it in the
# URL as %23 as well, since a bare # there starts a URL fragment.

# ── Database: Supabase ──────────────────────────────────────────────────────
# Queries go through the TRANSACTION pooler (6543) so several app instances fit
# inside the project's connection cap. Migrations need the SESSION pooler (5432)
# — advisory locks and transaction-scoped DDL do not survive a transaction
# pooler handing the next statement to a different backend.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=10"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# ── Object storage: Supabase Storage ────────────────────────────────────────
# Without these the API writes images to its own container filesystem, which is
# lost on every redeploy and invisible to any second instance.
# The service-role key bypasses RLS. Server-side only — never in a NEXT_PUBLIC_*.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR-SERVICE-ROLE-KEY"
SUPABASE_STORAGE_BUCKET="project_images"

# ── Redis: Upstash ──────────────────────────────────────────────────────────
# Must be the TCP endpoint (rediss://), not the REST one: BullMQ uses blocking
# commands that REST cannot serve. Without it, rate limiting silently falls back
# to per-instance memory and the analysis queue is disabled.
REDIS_URL="rediss://default:PASSWORD@HOST.upstash.io:6379"

# ── Secrets ─────────────────────────────────────────────────────────────────
# Generate fresh values, do not reuse the development ones:
#   openssl rand -hex 48
JWT_SECRET=""
JWT_REFRESH_SECRET=""
USER_VERIFICATION_TOKEN_SECRET=""
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ── Public origin ───────────────────────────────────────────────────────────
# The scheme and host users reach the app on. Password-reset and invitation
# links are built from this, so a wrong value mails out links to nowhere.
BASE_URL="https://your-domain.example"
APP_URL="https://your-domain.example"
ALLOWED_ORIGINS="https://your-domain.example"
# nginx sits in front, so trust exactly one X-Forwarded-For hop. Trusting more
# than there are proxies lets a client forge its own source address and defeat
# the rate limiter.
TRUST_PROXY_HOPS="1"

# ── Analysis engine ─────────────────────────────────────────────────────────
# Set in docker-compose.prod.yml to the compose service names; override only if
# the engine runs elsewhere.
ANALYSIS_QUEUE_ENABLED="true"
ANALYSIS_WORKER_ENABLED="true"
ANALYSIS_WORKER_CONCURRENCY="2"

# ── Google sign-in ──────────────────────────────────────────────────────────
# Authorised redirect URI must be BASE_URL + /api/auth/google/callback.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
REQUIRE_MFA_FOR_PLATFORM_ADMINS="true"

# ── Outbound mail ───────────────────────────────────────────────────────────
# Sign-in codes and invitations do not go out without this.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="SHM <no-reply@your-domain.example>"

# ── Billing ─────────────────────────────────────────────────────────────────
BILLING_ENABLED="true"
BILLING_PROVIDER="razorpay"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ═══════════════════════════════════════════════════════════════════════════
# Everything below is read by the code but was not set here. Each line shows
# the value the code falls back to, so an unset variable is a decision rather
# than an accident. Fill in the blanks; the rest can stay as they are.
# ═══════════════════════════════════════════════════════════════════════════

# ── Ingest ──────────────────────────────────────────────────────────────────
# SECURITY. Defaults to TRUE, meaning the single fleet-wide IOT_API_KEY is
# still accepted — one key that authenticates every device, so one leaked
# device compromises the whole fleet. Set to "false" once every device carries
# its own credential; the backend warns on each legacy-key ingest until then.
ALLOW_LEGACY_INGEST_KEY="true"

# ── Analysis engine ─────────────────────────────────────────────────────────
# docker-compose.prod.yml already sets the two URLs to the compose service
# names, and its `environment:` block wins over this file — these are here so
# the values are visible, and matter only if the engine runs elsewhere.
# SHM_ENGINE_URL="http://python-shm:8000"
# SHM_ENGINE_GRPC_URL="python-shm:50051"
# Baked into the backend image as an ENV; the contract is copied to /proto.
# SHM_ENGINE_PROTO_PATH="/proto/shm/engine/v1/engine.proto"
# "grpc" (default) or "http". gRPC is the fast path; HTTP is the fallback.
SHM_ENGINE_TRANSPORT="grpc"
SHM_ENGINE_TIMEOUT_MS="60000"

# ── Limits ──────────────────────────────────────────────────────────────────
# Rows a single telemetry export may return. Default 100000. Raising it raises
# the memory one request can hold.
TELEMETRY_EXPORT_ROW_LIMIT="100000"
# Organisation registrations per IP per hour (default 5) and code-bearing
# requests per quarter-hour (default 10). Both are brute-force ceilings; the
# test suite raises them for its own run and production should not.
REGISTER_RATE_LIMIT_MAX="5"
OTP_RATE_LIMIT_MAX="10"

# ── Redis ───────────────────────────────────────────────────────────────────
# Defaults to enabled. "false" forces the in-memory rate-limit store, which is
# per-instance — so several instances stop sharing one limit. Only for tests.
REDIS_ENABLED="true"

# ── Branding ────────────────────────────────────────────────────────────────
# Optional. Where a newly provisioned tenant takes its default logo from; unset
# means none is copied.
OPERATOR_LOGO_SOURCE=""

# ── Device ingest ───────────────────────────────────────────────────────────
# The fleet-wide key devices present as `x-api-key`. Generate a real value:
#   openssl rand -hex 32
# It authenticates EVERY device, so one leaked device exposes the whole fleet —
# which is why ALLOW_LEGACY_INGEST_KEY should become "false" once each device
# carries its own credential.
IOT_API_KEY=""

# ── Billing ─────────────────────────────────────────────────────────────────
# Only read when BILLING_PROVIDER is "generic"; with "razorpay" the Razorpay
# secret above verifies webhooks instead.
BILLING_WEBHOOK_SECRET=""
# The plan a self-service signup lands on, and the set it may choose from.
DEFAULT_SIGNUP_PLAN="starter"
SIGNUP_PLAN_CODES="starter,professional"

# ── Uploads ─────────────────────────────────────────────────────────────────
# Ceiling on a single uploaded file, in bytes (10 MB). Also the cap multer
# enforces on CSV import, which otherwise buffers a whole request into memory.
MAX_FILE_SIZE="10485760"
# Only used when Supabase Storage is NOT configured, as the local directory
# images are written to.
UPLOAD_DIR="uploads"

# ── Mail, Gmail form ────────────────────────────────────────────────────────
# The alternative to the SMTP_* block above. Set one pair or the other.
# GMAIL_PASSWORD is an app password, never the account password.
GMAIL_ACCOUNT=""
GMAIL_PASSWORD=""

# ── Set by the image and compose, listed for completeness ───────────────────
# NODE_ENV=production                    (docker-compose.prod.yml)
# PORT=3001                              (docker-compose.prod.yml)
# SHM_ENGINE_URL=http://python-shm:8000  (docker-compose.prod.yml)
# SHM_ENGINE_GRPC_URL=python-shm:50051   (docker-compose.prod.yml)
# SHM_ENGINE_PROTO_PATH=/proto/shm/engine/v1/engine.proto  (backend/Dockerfile)

# ── Ackcio FTP drop ─────────────────────────────────────────────────────────
# Where vsftpd writes the gateway's CSV uploads on this host. deploy/vsftpd/
# setup.sh creates it; docker-compose.prod.yml mounts it into the API at
# /ingest, which is what FTP_INGEST_DIR names inside the container. Leave
# FTP_INGEST_DIR empty to run without the FTP path (HTTP push still works).
FTP_DROP_DIR=/srv/ftp/ackcio
FTP_INGEST_DIR=/ingest
# How often incoming/ is scanned, and how long a file must sit unchanged
# before it is read (so a half-uploaded file is never processed).
FTP_INGEST_INTERVAL_MS=15000
FTP_INGEST_SETTLE_MS=5000
# The gateway writes LOCAL time with no zone unless the file header carries
# one. The zone assumed when it does not: India Standard Time here.
ACKCIO_CSV_UTC_OFFSET="+05:30"
