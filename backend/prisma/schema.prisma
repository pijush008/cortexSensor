// prisma/schema.prisma
// SHM Database Schema - PostgreSQL
// Source of truth: MySQL structualHealthMonitoring database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Queries go through Supabase's TRANSACTION pooler (port 6543). It multiplexes
  // many short-lived clients onto few server connections, which is what keeps
  // several app instances inside the project's connection cap.
  url      = env("DATABASE_URL")
  // Migrations do not. They need a session that persists across statements —
  // advisory locks, CREATE INDEX, transaction-scoped DDL — none of which survive
  // a transaction pooler handing the next statement to a different backend. This
  // points at the SESSION pooler (port 5432).
  directUrl = env("DIRECT_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum UserRole {
  superadmin
  admin
  contractor
  authority
  /// Self-service sign-up (Google). Belongs to no organization and browses the
  /// project directory only — deliberately distinct from `authority`, which is
  /// a project stakeholder who signs off on work.
  viewer
}

enum UserStatus {
  true_
  false_
}

enum ProjectStatus {
  not_start
  start
  pause
  end
}

enum DeviceStatus {
  active
  inactive
}

enum YesNo {
  true_
  false_
}

enum ActiveOneZero {
  one
  zero
}

// ─── TENANCY & RBAC ──────────────────────────────────────────────────────────
// The Tenant is the isolation root. Every tenant-owned table carries tenantId
// so isolation is a column the database enforces, not a helper each route has
// to remember to call. Prior to this the only tenant signal was User.parentId,
// which meant a single forgotten check was a cross-tenant leak.

enum TenantStatus {
  active
  suspended
  closed
}

enum MembershipStatus {
  active
  invited
  disabled
}

/// Tenant roles. SUPER_ADMIN is deliberately absent: a platform operator is
/// not a member of any organization (§19), and is modelled by
/// User.isPlatformAdmin instead. Giving it a Membership row would let a
/// platform operator be silently scoped into one tenant.
enum RoleKey {
  ORGANIZATION_ADMIN
  SHM_ENGINEER
  TECHNICIAN
  VIEWER
}

model Tenant {
  /// Immutable external identifier. Names are editable; ids are not (§15).
  publicId  String       @unique @db.VarChar(32)
  id        Int          @id @default(autoincrement())
  name      String       @db.VarChar(255)
  slug      String       @unique @db.VarChar(64)
  status    TenantStatus @default(active)
  /// The organization's own logo, shown as the avatar for every one of its
  /// members. A RELATIVE path (uploads/tenants/<uuid>.png), matching
  /// Project.projectLogo and User.profileImage — never a URL, so the origin
  /// serving it can change without rewriting rows.
  ///
  /// Nullable even though registration requires one: organizations created
  /// before this existed, and those made by the seeds, have no logo, and a NOT
  /// NULL column would mean inventing a value for each. The requirement lives
  /// at the point of entry; the UI falls back to an initial letter.
  logoPath  String?      @db.VarChar(255)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  memberships  Membership[]
  projects     Project[]
  devices      Device[]
  sensors      Sensor[]
  structures   Structure[]
  locations    Location[]
  gateways     Gateway[]
  analysisRuns AnalysisRun[]
  baselines    Baseline[]
  alertRules   AlertRule[]
  alerts       Alert[]
  inspections  Inspection[]
  reports      Report[]
  subscription Subscription?
  invitations  ProjectInvitation[]

  @@index([status])
  @@map("tenants")
}

model Role {
  id          Int     @id @default(autoincrement())
  key         RoleKey @unique
  name        String  @db.VarChar(64)
  description String? @db.Text

  permissions RolePermission[]
  memberships Membership[]

  @@map("roles")
}

/// Permissions are rows, not hardcoded constants, so the grant matrix can be
/// inspected, audited and changed without a deploy (§18).
model Permission {
  id          Int     @id @default(autoincrement())
  key         String  @unique @db.VarChar(64)
  description String? @db.Text

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// A user's association with one tenant, carrying exactly one role.
/// A user may belong to several tenants; the active tenant is resolved per
/// request from the session, never from a client-supplied tenant id (§17).
model Membership {
  id        Int              @id @default(autoincrement())
  userId    Int
  tenantId  Int
  roleId    Int
  status    MembershipStatus @default(active)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([userId, tenantId])
  @@index([tenantId, status])
  @@index([userId])
  @@index([roleId])
  @@map("memberships")
}

// ─── USERS ───────────────────────────────────────────────────────────────────

model User {
  id              Int        @id @default(autoincrement())
  /// DEPRECATED — superseded by Membership.role. Retained and kept in sync so
  /// the existing frontend (which stores userType in localStorage) and the
  /// not-yet-migrated service queries keep working during the RBAC migration.
  /// Remove once every consumer reads permissions instead.
  userType        UserRole
  /// DEPRECATED — superseded by Membership.tenantId. Same rationale.
  parentId        Int        @default(0)
  /// Platform operator (SUPER_ADMIN). Holds no Membership: a platform operator
  /// administers the SaaS, not an organization (§19).
  isPlatformAdmin Boolean    @default(false)
  /// TOTP shared secret, set at enrolment. Null until MFA is enrolled.
  mfaSecret       String?    @db.VarChar(128)
  /// Set when enrolment is confirmed by a valid code. MFA is only enforced
  /// once this is non-null, so a half-finished enrolment cannot lock a user out.
  mfaEnabledAt    DateTime?
  firstName       String     @db.VarChar(255)
  lastName        String     @db.VarChar(255)
  emailId         String     @unique @db.VarChar(255)
  phoneNo         String     @db.VarChar(255)
  isMailVerified  YesNo      @default(false_)
  isUserVerified  YesNo      @default(false_)
  password        String     @db.VarChar(255)
  profileImage    String?    @db.Text
  /// The organisation this person works for — a contractor's construction firm,
  /// an authority's department. Free text on the account, NOT a Tenant: they
  /// are members of the project's organization, and giving them one of their
  /// own would put them across an isolation boundary from the project itself.
  companyName     String?    @db.VarChar(255)
  /// That company's logo. A RELATIVE path (uploads/users/<uuid>.png), matching
  /// Tenant.logoPath and Project.projectLogo — never a URL, so the origin
  /// serving it can change without rewriting rows.
  companyLogo     String?    @db.VarChar(255)
  status          UserStatus
  csv             Int?       @default(0)
  createdAt       DateTime?  @default(now())
  updatedAt       DateTime?
  isDelete        YesNo      @default(false_)

  // Relations
  createdProjects Project[]            @relation("ProjectCreator")
  managedProjects Project[]            @relation("ProjectContractor")
  auditedProjects Project[]            @relation("ProjectAuthority")
  assignedDevices Device[]             @relation("DeviceAdmin")
  updatedDevices  Device[]             @relation("DeviceUpdater")
  assignedSensors Sensor[]             @relation("SensorAdmin")
  firebaseTokens  FirebaseToken[]
  tempOtps        TempOtp[]
  passwordResets  PasswordResetToken[]
  auditLogs       AuditLog[]
  refreshTokens   RefreshToken[]
  subscription    Subscription?
  memberships     Membership[]
  sentInvitations ProjectInvitation[]  @relation("InvitationInviter")

  @@index([userType])
  @@index([parentId])
  @@map("users")
}

// ─── DEVICE TYPES ────────────────────────────────────────────────────────────

model DeviceType {
  id          Int           @id @default(autoincrement())
  deviceType  String        @db.VarChar(255)
  deviceImage String?       @db.VarChar(255)
  status      ActiveOneZero
  createdAt   DateTime      @default(now())

  devices Device[]

  @@map("device_types")
}

// ─── DEVICES ─────────────────────────────────────────────────────────────────

model Device {
  id               Int             @id @default(autoincrement())
  /// Isolation root. Null only while a device is in the unassigned pool held
  /// by the platform operator, before it is allocated to a customer.
  tenantId         Int?
  deviceName       String          @db.VarChar(255)
  deviceType       Int
  channelCount     Int
  /// The unit's serial number, as printed on the hardware.
  ///
  /// Unique: two cabinets cannot carry the same serial, and the project form
  /// shows this string to tell otherwise similarly-named devices apart — a
  /// duplicate there would make the chooser ambiguous in exactly the way a
  /// list of identically-named rows is.
  ///
  /// Still nullable, and Postgres allows many NULLs under a unique index, so
  /// devices recorded before a serial was known are unaffected.
  deviceId         String?         @unique @db.VarChar(255)
  gatewayDeviceId  String          @db.VarChar(255)
  addedBy          Int             @default(0)
  deviceStatus     DeviceStatus    @default(inactive)
  deviceStartDate  DateTime
  assignedAdmin    Int?
  assignSensor     String?         @db.VarChar(255) // JSON array e.g. "[28,29]"
  createdAt        DateTime
  status           ActiveOneZero   @default(one)
  updatedBy        Int?
  updatedAt        DateTime?
  isDelete         YesNo           @default(false_)
  updateHeartBeat  DateTime?       @default(now()) @db.Timestamptz()
  isOngoing        Boolean         @default(false)
  /// Real relation to the edge gateway. `gatewayDeviceId` (a string) is kept in
  /// sync for the existing ingest path and retired once ingest is migrated.
  gatewayId        Int?
  /// Lifecycle state (§27), distinct from the legacy active/inactive flag.
  lifecycle        DeviceLifecycle @default(unregistered)
  decommissionedAt DateTime?

  // Relations
  tenant           Tenant?            @relation(fields: [tenantId], references: [id])
  gateway          Gateway?           @relation(fields: [gatewayId], references: [id])
  credentials      DeviceCredential[]
  deviceTypeRecord DeviceType         @relation(fields: [deviceType], references: [id])
  admin            User?              @relation("DeviceAdmin", fields: [assignedAdmin], references: [id])
  updater          User?              @relation("DeviceUpdater", fields: [updatedBy], references: [id])

  @@index([assignedAdmin])
  @@index([tenantId])
  @@index([gatewayId])
  @@index([tenantId, lifecycle])
  @@index([deviceType])
  @@index([updatedBy])
  @@map("devices")
}

// ─── DEVICE CHANNELS ─────────────────────────────────────────────────────────
// deviceId is a STRING reference to Device.id (e.g. "33"), NOT a real FK.
// Stored as varchar; no relational constraint.

model DeviceChannel {
  id             Int           @id @default(autoincrement())
  deviceId       String        @db.VarChar(255)
  channelNumber  String        @db.VarChar(255)
  channelName    String?       @db.VarChar(255)
  triggerValue   String?       @db.VarChar(255)
  thresholdValue String?       @db.VarChar(255)
  assignSensor   String?       @db.VarChar(255) // Sensor ID as string
  activeStatus   ActiveOneZero @default(zero)

  @@index([deviceId])
  @@map("device_channels")
}

// ─── SENSOR TYPES ────────────────────────────────────────────────────────────

model SensorType {
  id               Int           @id @default(autoincrement())
  sensorType       String        @db.VarChar(255)
  sensorIcon       String        @db.VarChar(255)
  calibrationValue String        @db.VarChar(255)
  status           ActiveOneZero
  unit             String?       @db.VarChar(255)

  sensors Sensor[]

  @@map("sensor_types")
}

// ─── SENSORS ─────────────────────────────────────────────────────────────────

model Sensor {
  id               Int           @id @default(autoincrement())
  /// Isolation root. Null while held in the platform's unassigned pool.
  tenantId         Int?
  sensorName       String        @db.VarChar(255)
  sensorTypeID     Int
  assignedAdmin    Int?
  calibrationValue String?       @db.VarChar(255)
  /// VarChar, not Char. As a fixed-width CHAR(255) Postgres padded every unit
  /// with trailing spaces, so "uS" was stored and returned as "uS" plus 253
  /// blanks — and rendered that way on every axis label and reading (§50).
  unit             String        @db.VarChar(32)
  status           ActiveOneZero @default(one)
  createdAt        DateTime      @default(now())

  tenant       Tenant?             @relation(fields: [tenantId], references: [id])
  sensorType   SensorType          @relation(fields: [sensorTypeID], references: [id])
  assignments  SensorAssignment[]
  calibrations SensorCalibration[]
  admin        User?               @relation("SensorAdmin", fields: [assignedAdmin], references: [id])

  @@index([assignedAdmin])
  @@index([tenantId])
  @@index([sensorTypeID])
  @@map("sensors")
}

// ─── PROJECTS ────────────────────────────────────────────────────────────────
// deviceId is a STRING reference (may be NULL), sensorId is JSON text.
// projectDevice is JSON text. No real FK to Device.

model Project {
  id              Int           @id @default(autoincrement())
  /// Isolation root. Every query for a non-platform user is filtered on this.
  tenantId        Int
  projectName     String        @db.VarChar(255)
  projectUniqueID String?       @db.VarChar(512)
  uniqueId        String?       @db.VarChar(50)
  projectLocation String        @db.VarChar(255)
  startDate       DateTime      @db.Date()
  actualStartDate DateTime?     @db.Date()
  projectLogo     String?       @db.VarChar(255)
  endDate         DateTime?     @db.Date()
  contractorId    Int?
  authorityId     Int?
  deviceId        String?       @db.VarChar(255) // Device ID string (e.g. "33")
  sensorId        String?       @db.Text // JSON array e.g. "[28,29]"
  /// The project image shown on the dashboard, uploaded by the assigned
  /// contractor. dashImage2 is the legacy second slot, kept so images already
  /// uploaded there are not orphaned; new uploads write dashImage.
  dashImage       String?       @db.VarChar(255)
  dashImage2      String?       @db.VarChar(255)
  /// Source for the dashboard's live video panel — an HLS or MP4 URL for the
  /// site camera. A URL rather than stored media: the platform does not host
  /// video, and a live feed is not ours to record.
  liveVideoUrl    String?       @db.VarChar(512)
  status          ProjectStatus @default(not_start)
  offset          Int           @default(0)
  createdAt       DateTime      @default(now())
  createdBy       Int
  updatedAt       DateTime?     @default(now())
  updatedBy       Int?
  projectDevice   Json? // JSON blob with device snapshot
  csvData         Boolean?      @default(false)
  isDelete        Boolean?      @default(false)
  isRegistered    Boolean       @default(false)

  // Relations
  tenant        Tenant              @relation(fields: [tenantId], references: [id])
  creator       User                @relation("ProjectCreator", fields: [createdBy], references: [id])
  contractor    User?               @relation("ProjectContractor", fields: [contractorId], references: [id])
  authority     User?               @relation("ProjectAuthority", fields: [authorityId], references: [id])
  projectEmails ProjectEmail[]
  sensorData    SensorData[]
  structures    Structure[]
  invitations   ProjectInvitation[]
  /// The Ackcio gateway this project owns, exclusively, while it runs.
  gateway       Gateway?            @relation("ProjectGateway")

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([createdBy])
  @@index([contractorId])
  @@index([authorityId])
  @@map("projects")
}

// ─── GATEWAYS, DEVICE LIFECYCLE & CREDENTIALS ────────────────────────────────
// A Gateway is the field edge node (Raspberry Pi) that aggregates ESP32/DAQ
// devices and forwards to the cloud. It existed only as a `gatewayDeviceId`
// string on Device, which is why gateway health had nowhere to live and the
// gateways screen had to be invented. It is now a real, tenant-owned entity.

enum GatewayStatus {
  provisioning
  active
  degraded
  offline
  maintenance
  decommissioned
}

/// Device lifecycle (§27). Distinct from `deviceStatus`, the legacy
/// active/inactive flag, which is retained for the existing ingest path.
enum DeviceLifecycle {
  unregistered
  provisioning
  active
  degraded
  offline
  maintenance
  decommissioned
}

model Gateway {
  id       Int    @id @default(autoincrement())
  publicId String @unique @db.VarChar(32)
  tenantId Int

  /// The identifier the hardware reports as `GatewayDeviceId` in telemetry.
  /// Unique globally because ingest resolves a gateway by this alone, before
  /// any tenant context exists.
  gatewayKey String @unique @db.VarChar(128)

  name        String  @db.VarChar(160)
  description String? @db.Text

  /// The ONE project this gateway serves, or null while it is available.
  ///
  /// Unique, so the database itself refuses a second project claiming the
  /// same gateway; Postgres lets any number of rows carry NULL under a unique
  /// index, so free gateways do not collide with each other. The claim is
  /// written in the same transaction as the project that makes it, and
  /// released when that project ends or is deleted.
  projectId   Int?      @unique
  claimedAt   DateTime?
  /// Optional placement. A gateway is often mounted on the structure it serves,
  /// but may sit in a cabinet covering several.
  structureId Int?
  locationId  Int?

  status GatewayStatus @default(provisioning)

  firmwareVersion String? @db.VarChar(64)
  hardwareModel   String? @db.VarChar(120)

  /// Last heartbeat. Null means the gateway has never reported — which the UI
  /// states plainly rather than rendering as "offline for 0 minutes".
  lastSeenAt    DateTime?
  /// Store-and-forward depth reported by the edge buffer (§12).
  bufferedCount Int?

  /// SHA-256 of the token embedded in this gateway's push URL.
  ///
  /// An Ackcio gateway authenticates by URL alone: its dashboard takes an
  /// address to POST to and nothing else, so the secret has to travel in the
  /// path. Only the hash is stored; the token is shown once, at issue, and
  /// re-issuing replaces it, which is how a leaked URL is revoked.
  ingestTokenHash       String?   @unique @db.VarChar(128)
  ingestTokenIssuedAt   DateTime?
  ingestTokenLastUsedAt DateTime?

  createdAt DateTime @default(now())
  createdBy Int?
  updatedAt DateTime @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project? @relation("ProjectGateway", fields: [projectId], references: [id])
  devices Device[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("gateways")
}

/// Per-device ingest credential (§58, SEC-4).
///
/// Replaces a single fleet-wide shared secret, which could not be rotated or
/// revoked for one device and exposed every tenant's ingestion if leaked.
/// The secret is stored only as a SHA-256 hash; it is shown once at issue.
model DeviceCredential {
  id       Int @id @default(autoincrement())
  tenantId Int
  deviceId Int

  /// Public, non-secret lookup handle sent alongside the secret. Indexing on
  /// this means authentication is a single indexed read rather than a scan
  /// with a hash comparison per row.
  keyId      String @unique @db.VarChar(48)
  secretHash String @db.VarChar(128)

  label      String?   @db.VarChar(120)
  createdAt  DateTime  @default(now())
  createdBy  Int?
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([tenantId])
  @@map("device_credentials")
}

// ─── SENSOR ASSIGNMENT & CALIBRATION HISTORY ─────────────────────────────────

/// Where a sensor was installed, and when (§16).
///
/// Sensors move. Overwriting the sensor→location link would silently rewrite
/// the meaning of every historical measurement, so placement is an append-only
/// interval: `validTo` null means "currently installed here". A measurement
/// resolves its location by its timestamp, not by where the sensor sits today.
model SensorAssignment {
  id       Int @id @default(autoincrement())
  tenantId Int
  sensorId Int

  locationId    Int?
  deviceId      Int?
  /// Channel on the device this sensor is wired to, when applicable.
  channelNumber String? @db.VarChar(32)

  /// Physical orientation, which changes what an axis means (§32).
  orientation String? @db.VarChar(64)

  validFrom DateTime  @default(now())
  validTo   DateTime?

  notes     String?  @db.Text
  createdAt DateTime @default(now())
  createdBy Int?

  sensor   Sensor    @relation(fields: [sensorId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id])

  @@index([sensorId, validFrom])
  @@index([locationId])
  @@index([tenantId])
  @@map("sensor_assignments")
}

/// Calibration history (§32). Append-only: a superseded calibration is never
/// edited, because reprocessing historical data requires the coefficient that
/// was in force at the time of the reading.
model SensorCalibration {
  id       Int @id @default(autoincrement())
  tenantId Int
  sensorId Int

  /// Multiplier applied to a raw reading, plus an optional zero offset.
  calibrationValue String  @db.VarChar(64)
  zeroOffset       String? @db.VarChar(64)
  unit             String? @db.VarChar(32)

  manufacturer String? @db.VarChar(120)
  model        String? @db.VarChar(120)
  serialNumber String? @db.VarChar(120)
  rangeMin     String? @db.VarChar(64)
  rangeMax     String? @db.VarChar(64)
  accuracy     String? @db.VarChar(64)
  resolution   String? @db.VarChar(64)

  /// Traceability: who certified it, against what, and until when.
  certificateRef String?   @db.VarChar(160)
  performedBy    String?   @db.VarChar(160)
  performedAt    DateTime
  validUntil     DateTime?

  notes     String?  @db.Text
  createdAt DateTime @default(now())
  createdBy Int?

  sensor Sensor @relation(fields: [sensorId], references: [id], onDelete: Cascade)

  @@index([sensorId, performedAt])
  @@index([tenantId])
  @@map("sensor_calibrations")
}

// ─── STRUCTURES & LOCATIONS ──────────────────────────────────────────────────
// The middle of the monitoring hierarchy (§14):
//   Tenant → Project → Structure → Location → Gateway → Device → Sensor
// A Structure is the physical asset under observation. A Location is a named
// point ON that structure where instrumentation is installed — "Pier P-17 /
// North Bearing". Measurements are meaningless without it: a strain reading
// with no location cannot be compared, mapped or acted on.

enum StructureType {
  bridge
  flyover
  building
  tower
  dam
  tunnel
  railway
  pier
  industrial
  other
}

enum StructureStatus {
  planned
  commissioning
  monitoring
  paused
  decommissioned
}

model Structure {
  id        Int    @id @default(autoincrement())
  /// Immutable external identifier. Names and codes are editable (§15).
  publicId  String @unique @db.VarChar(32)
  tenantId  Int
  projectId Int

  /// Human label, editable.
  name String        @db.VarChar(160)
  /// Operator's own asset reference (e.g. "BR-NH48-017"). Unique per tenant so
  /// two customers may use the same scheme without collision.
  code String        @db.VarChar(64)
  type StructureType @default(other)

  description String? @db.Text

  // Geography. Nullable because an asset may be registered before it is
  // surveyed; the UI shows "not recorded" rather than a placeholder value.
  latitude    Decimal? @db.Decimal(9, 6)
  longitude   Decimal? @db.Decimal(9, 6)
  /// Free-text site address or chainage reference.
  siteAddress String?  @db.VarChar(255)

  // Engineering metadata. Used for reporting context and, later, to align a
  // structure with its FEM model (§54). All optional: recording a fact you do
  // not have is worse than leaving it blank.
  constructionYear Int?
  spanCount        Int?
  lengthMetres     Decimal?  @db.Decimal(10, 2)
  material         String?   @db.VarChar(120)
  designStandard   String?   @db.VarChar(120)
  commissionedAt   DateTime?

  status    StructureStatus @default(planned)
  createdAt DateTime        @default(now())
  createdBy Int?
  updatedAt DateTime        @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  locations Location[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([projectId])
  @@index([tenantId, status])
  @@map("structures")
}

model Location {
  id          Int    @id @default(autoincrement())
  publicId    String @unique @db.VarChar(32)
  tenantId    Int
  structureId Int

  name String @db.VarChar(160)
  /// Operator's point reference (e.g. "P17-NB"). Unique within its structure.
  code String @db.VarChar(64)

  description String? @db.Text

  // Where on the structure. `station` is chainage along the asset; the local
  // offsets are structure-relative coordinates, which is what a schematic or a
  // FEM node mapping needs later (§54). Nullable throughout — an unsurveyed
  // point is recorded as unknown, not as zero.
  stationMetres   Decimal? @db.Decimal(10, 3)
  elevationMetres Decimal? @db.Decimal(10, 3)
  offsetXMetres   Decimal? @db.Decimal(10, 3)
  offsetYMetres   Decimal? @db.Decimal(10, 3)
  offsetZMetres   Decimal? @db.Decimal(10, 3)

  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  createdBy Int?
  updatedAt DateTime @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  structure         Structure          @relation(fields: [structureId], references: [id], onDelete: Cascade)
  sensorAssignments SensorAssignment[]

  @@unique([structureId, code])
  @@index([tenantId])
  @@index([structureId])
  @@map("locations")
}

// ─── INSPECTIONS & REPORTS ───────────────────────────────────────────────────
// The link between what the instruments measured and what a person actually
// found on site (§53). An analytics platform that cannot record "we went and
// looked, and here is what was there" produces findings nobody can close.

enum InspectionType {
  routine
  triggered
  post_event
  commissioning
  decommissioning
}

enum InspectionOutcome {
  no_action_required
  monitor
  repair_recommended
  urgent_action_required
  inconclusive
}

model Inspection {
  id       Int    @id @default(autoincrement())
  publicId String @unique @db.VarChar(32)
  tenantId Int

  structureId Int
  locationId  Int?
  /// The alert that prompted this visit, when there was one. This is what
  /// closes the loop from detection to field verification.
  alertId     Int?

  type    InspectionType    @default(routine)
  outcome InspectionOutcome @default(monitor)

  /// When the inspection happened, which is not when it was recorded — an
  /// inspector often writes it up the next day.
  performedAt   DateTime @db.Timestamptz()
  /// Free text rather than a user FK: an inspection is frequently carried out
  /// by a third-party engineer who has no account on this platform.
  inspectorName String   @db.VarChar(160)
  inspectorOrg  String?  @db.VarChar(160)

  /// What was observed. Kept separate from the recommendation so a later
  /// reader can tell what was SEEN from what was CONCLUDED.
  observations   String    @db.Text
  recommendation String?   @db.Text
  /// Follow-up, filled in when the recommended action has been carried out.
  resolutionNote String?   @db.Text
  resolvedAt     DateTime?

  /// Ambient conditions at the time, so a measurement anomaly can be correlated
  /// with what the weather was doing (§37).
  environmentalContext Json?

  createdAt DateTime @default(now())
  createdBy Int?
  updatedAt DateTime @updatedAt

  tenant Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  photos InspectionPhoto[]

  @@index([tenantId, performedAt])
  @@index([structureId, performedAt])
  @@index([alertId])
  @@map("inspections")
}

/// Photo metadata. The bytes live in object storage (§8), never in Postgres.
///
/// `storageKey` is recorded even before a storage backend is configured, so
/// the platform can say "this photo was taken but storage is not configured"
/// rather than silently accepting an upload it discarded.
model InspectionPhoto {
  id           Int @id @default(autoincrement())
  inspectionId Int
  tenantId     Int

  storageKey  String    @db.VarChar(512)
  caption     String?   @db.VarChar(500)
  contentType String?   @db.VarChar(120)
  byteSize    Int?
  /// Null until the bytes are confirmed present in object storage.
  uploadedAt  DateTime?
  createdAt   DateTime  @default(now())

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
  @@map("inspection_photos")
}

enum ReportStatus {
  queued
  generating
  ready
  failed
}

/// A monitoring report (§52).
///
/// Immutable once ready, and versioned. A report is a statement about a period
/// that someone may act on or file with an authority; regenerating it in place
/// when new data arrives would silently change a document that has already been
/// read. A new period, or new data, produces a new version.
model Report {
  id       Int    @id @default(autoincrement())
  publicId String @unique @db.VarChar(32)
  tenantId Int

  projectId   Int?
  structureId Int?

  title   String       @db.VarChar(200)
  version Int          @default(1)
  status  ReportStatus @default(queued)

  periodFrom DateTime @db.Timestamptz()
  periodTo   DateTime @db.Timestamptz()

  /// The rendered document: measured content, data quality, analysis
  /// references and limitations. Structured rather than a blob so it can be
  /// re-rendered to PDF or HTML without regenerating the underlying figures.
  content    Json?
  /// Object storage key for a rendered PDF, once storage is configured.
  storageKey String? @db.VarChar(512)
  error      String? @db.Text

  generatedAt DateTime?
  createdAt   DateTime  @default(now())
  createdBy   Int?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([structureId, periodFrom])
  @@map("reports")
}

// ─── ALERTS ──────────────────────────────────────────────────────────────────
// An alert is a claim that something needs an engineer's attention. Three
// things make that claim trustworthy rather than noise:
//
//   1. Severity is DERIVED from stated rules, never chosen ad hoc (§41).
//   2. One continuous condition is ONE alert. Re-raising per reading buries
//      the engineer and trains them to ignore the inbox (§40).
//   3. A sensor fault is categorised as a SENSOR fault, never as a structural
//      finding (§31). A dead channel is not a damaged bridge.

enum AlertSeverity {
  info
  low
  medium
  high
  critical
}

enum AlertStatus {
  open
  acknowledged
  investigating
  resolved
  closed
}

/// What KIND of problem this is. Kept separate from severity because they
/// answer different questions: category says what is wrong, severity says how
/// urgently someone must look.
enum AlertCategory {
  /// The structure's measured response changed. The only category that may
  /// ever imply a structural concern.
  structural
  /// The instrument is faulty: flatlined, saturated, out of range, drifting.
  sensor_health
  /// The data path is broken: gateway silent, packets lost, buffer draining.
  connectivity
  /// Traceability or configuration: calibration expired, no baseline.
  data_quality
}

model AlertRule {
  id       Int    @id @default(autoincrement())
  publicId String @unique @db.VarChar(32)
  tenantId Int

  name        String @db.VarChar(160)
  sensorId    Int?
  /// Null means the rule applies to every sensor on the structure.
  structureId Int?

  category AlertCategory @default(structural)

  /// Absolute bounds. Null disables that side of the test.
  minValue Float?
  maxValue Float?

  /// Consecutive breaching samples before an alert is raised. A single
  /// excursion is usually electrical noise; requiring persistence is what
  /// separates a real event from a spike (§40).
  consecutiveSamples Int @default(3)

  /// Re-notification interval for an alert that remains open. Prevents one
  /// ongoing condition from generating an unbounded stream of notifications.
  renotifyAfterMinutes Int @default(60)

  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  createdBy Int?
  updatedAt DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  alerts Alert[]

  @@index([tenantId, isEnabled])
  @@index([sensorId])
  @@map("alert_rules")
}

model Alert {
  id       Int    @id @default(autoincrement())
  publicId String @unique @db.VarChar(32)
  tenantId Int

  ruleId      Int?
  sensorId    Int?
  deviceId    Int?
  gatewayId   Int?
  locationId  Int?
  structureId Int?
  projectId   Int?

  category AlertCategory
  severity AlertSeverity
  status   AlertStatus   @default(open)

  title    String @db.VarChar(200)
  /// What was measured and why it tripped: the numbers behind the claim.
  /// An alert without evidence is an assertion an engineer cannot check.
  evidence Json

  /// How much the detector trusts this, 0..1. Reported, never invented: it is
  /// computed from persistence and data quality, and stored alongside the
  /// inputs that produced it.
  confidence Float?

  /// Stable identity of the CONDITION, not the reading. While an alert with
  /// this key is open, further breaches update it instead of raising a new one.
  dedupeKey String @db.VarChar(200)

  /// First and most recent breach observed for this condition.
  detectedAt      DateTime  @db.Timestamptz()
  lastObservedAt  DateTime  @db.Timestamptz()
  /// Number of breaching observations folded into this alert.
  occurrenceCount Int       @default(1)
  /// When a notification was last sent, so renotification can be rate limited.
  lastNotifiedAt  DateTime?

  assignedToId     Int?
  acknowledgedAt   DateTime?
  acknowledgedById Int?
  resolvedAt       DateTime?
  resolvedById     Int?
  closedAt         DateTime?
  /// Why it was resolved. Required on resolution: an alert closed without a
  /// reason teaches nobody anything.
  resolutionNote   String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rule   AlertRule?   @relation(fields: [ruleId], references: [id])
  events AlertEvent[]

  /// One open alert per condition. This is the deduplication guarantee, held
  /// by the database rather than by application logic that could race.
  @@unique([dedupeKey, status])
  @@index([tenantId, status, severity])
  @@index([tenantId, detectedAt])
  @@index([sensorId, detectedAt])
  @@index([ruleId])
  @@map("alerts")
}

/// Every transition, appended. An alert's history is the record of who knew
/// what and when — which is exactly what is asked for after an incident.
model AlertEvent {
  id      Int @id @default(autoincrement())
  alertId Int

  fromStatus  AlertStatus?
  toStatus    AlertStatus
  note        String?      @db.Text
  actorId     Int?
  /// Set when the transition was made by the detector rather than a person.
  isAutomatic Boolean      @default(false)
  createdAt   DateTime     @default(now())

  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId, createdAt])
  @@map("alert_events")
}

// ─── ANALYSIS (spectral, baselines) ──────────────────────────────────────────
// Every analysis output is versioned and traceable (§103): the window it was
// computed over, the method and parameters used, the engine version, and the
// baseline it was compared against. An engineering number that cannot be
// reproduced is not evidence, and reprocessing later must be able to explain
// why a stored result differs from a fresh one.

enum AnalysisStatus {
  queued
  running
  succeeded
  failed
}

enum AnalysisKind {
  spectrum
  baseline_compare
}

model AnalysisRun {
  id       Int    @id @default(autoincrement())
  publicId String @unique @db.VarChar(32)
  tenantId Int

  kind   AnalysisKind
  status AnalysisStatus @default(queued)

  sensorId    Int
  structureId Int?

  /// The exact window analysed. Stored rather than derived so a result stays
  /// meaningful even after more data arrives for the same period.
  windowFrom DateTime @db.Timestamptz()
  windowTo   DateTime @db.Timestamptz()

  /// Sampling rate used for the transform. Without it a frequency axis is
  /// meaningless, so it is recorded with the result rather than assumed.
  sampleRateHz Float?

  /// Method identifier and its parameters (window, detrend, segment length...).
  method     String? @db.VarChar(64)
  parameters Json?

  /// Version of the analysis engine that produced the result.
  engineVersion String? @db.VarChar(32)

  /// Baseline this run was compared against, when applicable.
  baselineId Int?

  /// Full result payload: spectrum, peaks, limitations, warnings.
  result Json?
  /// Populated when status is failed. Kept rather than discarded so a
  /// recurring failure can be diagnosed.
  error  String? @db.Text

  requestedBy Int?
  queuedAt    DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  baseline Baseline? @relation(fields: [baselineId], references: [id])

  @@index([tenantId, queuedAt])
  @@index([sensorId, queuedAt])
  @@index([status])
  @@index([baselineId])
  @@map("analysis_runs")
}

/// A reference spectrum for a sensor, captured from a period an engineer has
/// accepted as representative of the healthy structure.
///
/// Versioned and never edited: comparing today against a baseline that has
/// been quietly changed produces a shift that cannot be explained or defended.
model Baseline {
  id       Int    @id @default(autoincrement())
  publicId String @unique @db.VarChar(32)
  tenantId Int
  sensorId Int

  /// Increments per sensor. The active baseline is the highest version that is
  /// not retired.
  version Int     @default(1)
  label   String  @db.VarChar(160)
  notes   String? @db.Text

  /// The period the baseline was captured from.
  windowFrom DateTime @db.Timestamptz()
  windowTo   DateTime @db.Timestamptz()

  sampleRateHz  Float?
  method        String? @db.VarChar(64)
  parameters    Json?
  engineVersion String? @db.VarChar(32)

  /// Identified peaks that define this reference state.
  peaks Json

  /// Environmental conditions when captured, so a later comparison can account
  /// for them rather than attributing a thermal shift to the structure (§37).
  environmentalContext Json?

  isRetired Boolean  @default(false)
  createdAt DateTime @default(now())
  createdBy Int?

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runs   AnalysisRun[]

  @@unique([sensorId, version])
  @@index([tenantId])
  @@index([sensorId, isRetired])
  @@map("baselines")
}

// ─── MEASUREMENTS (time-series) ──────────────────────────────────────────────
//
// Replaces `sensor_data`, which could not become a TimescaleDB hypertable:
// Timescale requires the partitioning column to appear in EVERY unique index,
// and `sensor_data` has PRIMARY KEY (id) alone. This table is designed for that
// from the start — `ts` is part of the primary key and of the idempotency
// constraint — so the hypertable conversion in the migration simply works.
//
// `sensor_data` continues to be written as a compatibility shim while reports
// and exports still read it; that dual-write is removed once they migrate.

model Measurement {
  /// Surrogate id. Paired with `ts` in the primary key because Timescale
  /// requires the partition column in every unique index.
  id BigInt   @default(autoincrement())
  /// Measurement time as reported by the device, in UTC. This is the partition
  /// column and the axis every query uses — NOT ingestedAt, which is when the
  /// cloud happened to receive it and can lag by hours after an outage.
  ts DateTime @db.Timestamptz()

  tenantId Int
  sensorId Int

  deviceId  Int?
  gatewayId Int?

  /// Resolved AT INGEST from the sensor's placement history, so a measurement
  /// keeps the location it was actually taken at even after the sensor moves
  /// (§16, §79). Null when the sensor had no placement at that time.
  locationId  Int?
  structureId Int?

  /// Calibrated value, and the raw reading it came from. Keeping both means a
  /// recalibration can be reapplied to history without the original being lost
  /// (§47 raw vs derived).
  ///
  /// `value` is nullable on purpose. A device that sends NaN or Infinity has
  /// reported at this instant but has NOT reported a number, and storing 0 for
  /// it would invent a measurement — the one thing this platform must never do.
  /// Such a row is stored with a null value and the NOT_FINITE quality flag,
  /// which is itself the evidence of a failing channel (§30).
  value         Float? @db.DoublePrecision
  rawValue      Float? @db.DoublePrecision
  /// Which calibration record produced `value`, so any number on a chart can be
  /// traced back to the coefficient that made it.
  calibrationId Int?

  /// Per-sensor monotonic counter from the device. Gaps mean lost packets (§30).
  sequenceNumber BigInt?
  /// Device-generated idempotency key. A retried upload carries the same id, so
  /// replay after an outage cannot double-count (§12).
  eventId        String? @db.VarChar(64)

  /// Data-quality findings, e.g. OUT_OF_RANGE, FLATLINE, SEQUENCE_GAP.
  /// Flagged, never discarded: a suppressed bad reading hides a failing sensor
  /// (§30).
  qualityFlags String[] @default([])

  /// When the platform received it. The difference from `ts` is the delivery
  /// lag, which is how buffered-then-replayed data is recognised.
  ingestedAt DateTime @default(now()) @db.Timestamptz()

  @@id([ts, id])
  /// Idempotency. NULL event ids do not collide in Postgres, so legacy devices
  /// that send none are still accepted — they simply get no dedup protection.
  @@unique([eventId, ts])
  /// Declared explicitly because create_hypertable() also creates a `ts` index.
  /// Without it in the schema, every subsequent `prisma migrate diff` proposes
  /// dropping Timescale's own index.
  ///
  /// DESC, because that is the index create_hypertable() builds, and a fresh
  /// Timescale database therefore has it DESC whatever a later CREATE INDEX IF
  /// NOT EXISTS says. Declaring ASC made CI's drift check fail on every fresh
  /// database while passing on older ones. Latest-first is also the order the
  /// live views read in. The 20260917160000 migration brings every database
  /// to this definition.
  @@index([ts(sort: Desc)])
  @@index([sensorId, ts])
  @@index([tenantId, ts])
  @@index([structureId, ts])
  @@index([locationId, ts])
  @@map("measurements")
}

// ─── SENSOR DATA ─────────────────────────────────────────────────────────────

model SensorData {
  id         Int      @id @default(autoincrement())
  projectId  Int?
  deviceId   String   @db.VarChar(255)
  sensorId   String   @db.VarChar(255)
  sensorData Float    @db.Real()
  createdAt  DateTime

  project       Project?       @relation(fields: [projectId], references: [id])
  notifications Notification[]

  @@index([projectId, sensorId, createdAt])
  @@index([deviceId, createdAt])
  @@index([createdAt])
  @@map("sensor_data")
}

// ─── NODE DATA ───────────────────────────────────────────────────────────────
// DeviceId is the actual device id string (e.g. "fb8d"), not FK.

model NodeData {
  id              Int      @id @default(autoincrement())
  /// Battery as a PERCENTAGE, which is what the ESP32 firmware reports.
  battery         Int?
  /// Battery in MILLIVOLTS, which is what an Ackcio node reports. Kept in its
  /// own column rather than squeezed into `battery`: 3888 mV shown as 3888 %
  /// is the kind of wrong number this console must never draw.
  batteryMillivolts Int?
  temperature     Float    @db.Real()
  humidity        Float    @db.Real()
  pressure        Float    @db.Real()
  gatewayDeviceId String?  @db.VarChar(255)
  deviceId        String?  @db.VarChar(255)
  deviceName      String?  @db.VarChar(255)
  projectName     String?  @db.VarChar(255)
  deviceType      String?  @db.VarChar(255)
  createdAt       DateTime @default(now())
  deviceUpdatedAt DateTime

  @@map("node_data")
}

// ─── GATEWAY TELEMETRY (Ackcio Beam) ─────────────────────────────────────────
// The complete record of what an Ackcio gateway pushed, channel by channel.
//
// `measurements` holds the number the platform acts on. This holds EVERYTHING
// the gateway said about that number — the sensor's code and group, the
// channel type, the engineering reading AND the raw one, both unit strings,
// and the gateway's own valid/error verdict — so nothing in the push is lost
// and a reading on a chart can be traced back to the exact payload. Same key
// shape as measurements so it can be partitioned the same way.

model GatewayReading {
  id BigInt   @default(autoincrement())
  /// Node-reported capture time (Ackcio `Timestamp`), UTC.
  ts DateTime @db.Timestamptz()

  tenantId  Int
  gatewayId Int
  /// The platform Device row this node was resolved to.
  deviceId  Int?
  /// The platform Sensor row this channel was resolved to.
  sensorId  Int?

  /// Identifiers exactly as the gateway sent them.
  gatewayKey  String  @db.VarChar(128)
  nodeKey     String  @db.VarChar(64)
  nodeName    String? @db.VarChar(255)
  nodeType    String? @db.VarChar(64)
  projectName String? @db.VarChar(255)

  /// Ackcio `SensorId`: the sensor's position on the node or in a chain.
  sensorIndex Int
  code        String? @db.VarChar(255)
  group       String? @db.VarChar(255)
  sensorType  String? @db.VarChar(120)
  address     String? @db.VarChar(64)

  channelId      Int
  channelType    String? @db.VarChar(64)
  rawChannelType String? @db.VarChar(64)

  /// `Reading`: after the formula configured on the gateway. Null when the
  /// gateway sent something that is not a number.
  reading    Float?  @db.DoublePrecision
  /// `RawReading`: straight from the transducer.
  rawReading Float?  @db.DoublePrecision
  unit       String? @db.VarChar(64)
  rawUnit    String? @db.VarChar(64)
  /// The gateway's verdict: "valid", "error", or operator-defined text.
  description String? @db.VarChar(255)
  /// True when the payload type was ErrorSensorData.
  isError Boolean @default(false)

  /// Derived from gateway, node, sensor, channel and timestamp, so a retried
  /// push (§7 of the spec) is stored once.
  eventId    String   @db.VarChar(96)
  ingestedAt DateTime @default(now()) @db.Timestamptz()

  @@id([ts, id])
  @@unique([eventId, ts])
  /// Declared for the same reason as on `measurements`: create_hypertable()
  /// builds this DESC index itself, and an undeclared index reads as drift.
  @@index([ts(sort: Desc)])
  @@index([gatewayId, ts(sort: Desc)])
  @@index([deviceId, ts(sort: Desc)])
  @@index([sensorId, ts(sort: Desc)])
  @@index([tenantId, ts])
  @@map("gateway_readings")
}

/// Ackcio NetworkData: one row per report of a node's mesh link.
model NodeNetworkData {
  id Int      @id @default(autoincrement())
  ts DateTime @db.Timestamptz()

  tenantId  Int
  gatewayId Int
  deviceId  Int?

  gatewayKey String  @db.VarChar(128)
  nodeKey    String  @db.VarChar(64)
  /// The node or gateway this node routes through.
  parentKey  String? @db.VarChar(64)
  /// Link quality, percent.
  etx        Int?
  /// Signal strength, dBm.
  rssi       Int?

  ingestedAt DateTime @default(now()) @db.Timestamptz()

  @@index([gatewayId, ts(sort: Desc)])
  @@index([deviceId, ts(sort: Desc)])
  @@map("node_network_data")
}

/// What happened to a file the gateway uploaded over FTP(S).
enum IngestionFileStatus {
  /// Seen on disk, not yet handled.
  received
  /// Every row stored (or recognised as already stored).
  processed
  /// Could not be parsed or stored; the file is kept for inspection.
  failed
  /// Named for a gateway nobody has registered. Kept, never assigned.
  unknown_gateway
  /// Same content as a file already processed; skipped.
  duplicate
}

/// One row per file the FTP drop received — the ingestion ledger.
///
/// This is how a file is processed exactly once (the content hash is unique),
/// how a failed file is found again with its error, and how an unregistered
/// gateway's uploads are surfaced to an administrator instead of quietly
/// attached to somebody's project.
model IngestionFile {
  id Int @id @default(autoincrement())

  /// Null for a file from an unknown gateway: it belongs to nobody yet.
  tenantId  Int?
  gatewayId Int?
  projectId Int?

  /// Parsed from the file name, as the gateway wrote it.
  gatewayKey String? @db.VarChar(128)
  nodeKey    String? @db.VarChar(64)
  /// SensorData, NodeData, NetworkData, HeartbeatData or ErrorSensorData.
  fileType   String  @db.VarChar(32)

  fileName String @db.VarChar(512)
  /// Where the file now lives: the processed or failed directory.
  filePath String @db.VarChar(1024)
  /// SHA-256 of the content. Unique: the same upload twice is stored once.
  sha256    String @unique @db.VarChar(64)
  sizeBytes Int

  status IngestionFileStatus @default(received)
  /// Data rows in the file, excluding the header.
  rowsTotal     Int @default(0)
  /// Rows that produced new readings.
  rowsStored    Int @default(0)
  /// Rows already stored by an earlier file or push.
  rowsDuplicate Int @default(0)
  /// Why processing failed, for the administrator.
  error         String? @db.Text

  receivedAt  DateTime  @default(now()) @db.Timestamptz()
  processedAt DateTime? @db.Timestamptz()

  @@index([status, receivedAt(sort: Desc)])
  @@index([tenantId, receivedAt(sort: Desc)])
  @@index([gatewayKey, receivedAt(sort: Desc)])
  @@map("ingestion_files")
}

/// Ackcio HeartbeatData: the gateway's own health, hourly.
model GatewayHeartbeat {
  id Int      @id @default(autoincrement())
  ts DateTime @db.Timestamptz()

  tenantId   Int
  gatewayId  Int
  gatewayKey String @db.VarChar(128)

  /// The free-text SD card summary, e.g. "11.4GB free / 14.5GB total ( 18.0% )".
  disk           String? @db.VarChar(255)
  diskUsed       Float?
  diskSpace      Float?
  powerInVolts   Float?
  powerInCurrent Float?
  temperature    Float?
  humidity       Float?
  pressure       Float?
  /// Cumulative traffic this month, kB.
  dataUsage      Float?
  internetMode   String? @db.VarChar(32)

  ingestedAt DateTime @default(now()) @db.Timestamptz()

  @@index([gatewayId, ts(sort: Desc)])
  @@map("gateway_heartbeats")
}

// ─── NOTIFICATIONS ───────────────────────────────────────────────────────────

model Notification {
  id           Int      @id @default(autoincrement())
  sensorDataId Int
  min          String?  @db.Char(255)
  max          String?  @db.Char(255)
  createdAt    DateTime

  sensorData SensorData @relation(fields: [sensorDataId], references: [id])

  @@index([sensorDataId])
  @@map("notifications")
}

// ─── PROJECT EMAILS ──────────────────────────────────────────────────────────

model ProjectEmail {
  id        Int     @id @default(autoincrement())
  email     String  @db.VarChar(255)
  /// Who the alert is addressed to, so a warning opens "Hello Asha," rather
  /// than at a bare address. Optional: rows created before this existed have
  /// none, and the mail falls back to greeting by project.
  name      String? @db.VarChar(120)
  isEnable  Boolean @default(true)
  projectId Int

  project Project @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@map("project_emails")
}

// ─── FIREBASE TOKENS ────────────────────────────────────────────────────────

model FirebaseToken {
  id        Int           @id @default(autoincrement())
  userId    Int
  token     String        @db.Text
  status    ActiveOneZero @default(one)
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])

  @@map("firebase_tokens")
}

// ─── TEMP OTPs ──────────────────────────────────────────────────────────────

model TempOtp {
  id        Int      @id @default(autoincrement())
  userId    Int
  otp       String   @db.VarChar(100)
  /// What this code may be redeemed for.
  ///
  /// Load-bearing, not bookkeeping: validateOTP exchanges a code for a
  /// password-reset token, so without this a second-factor code mailed at
  /// sign-in could be redeemed to reset the password instead — turning a
  /// defence into a takeover path. Every read filters on it.
  purpose   String   @default("password_reset") @db.VarChar(32)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, purpose])
  @@map("temp_otps")
}

/// A single-use password reset link.
///
/// The token itself is never stored — only its SHA-256 hash, exactly as refresh
/// tokens are handled. A stolen database backup then yields no usable reset
/// links, and a leaked row cannot be replayed against the account it belongs to.
///
/// Rows are kept after use rather than deleted so that a second click on the
/// same link can be answered "this link has already been used" instead of the
/// indistinguishable "invalid link", and so the reset is visible in the record.
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  /// SHA-256 of the token that was emailed. Never the token.
  tokenHash String    @unique @db.VarChar(128)
  expiresAt DateTime
  usedAt    DateTime?
  /// Where the request came from, for the security record.
  requestIp String?   @db.VarChar(45)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ─── REFRESH TOKENS (auth rotation & revocation) ────────────────────────────

model RefreshToken {
  id         Int       @id @default(autoincrement())
  userId     Int
  tokenHash  String    @unique @db.VarChar(128)
  familyId   String    @db.VarChar(64)
  expiresAt  DateTime
  revokedAt  DateTime?
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ─── BILLING / SUBSCRIPTIONS ────────────────────────────────────────────────
// One subscription per admin (each admin is its own billing organization).
// Superadmins are complimentary — they hold no subscription record.

/// Subscription lifecycle (§25).
///
/// `past_due` and `expired` are deliberately distinct: past_due is a payment
/// that failed but is still within its grace period, where access continues;
/// expired is grace exhausted, where it does not. Collapsing them would mean
/// either cutting a customer off on the first failed charge, or never cutting
/// them off at all.
enum SubscriptionStatus {
  /// Registered but not yet paid for. The account exists so a payment can be
  /// attached to it, and grants nothing until a verified webhook says the
  /// charge settled. Distinct from `expired`, which means access was once
  /// granted and has lapsed — telling a new customer their brand-new account
  /// has "expired" is both wrong and alarming.
  pending
  trial
  active
  past_due
  canceled
  expired
  suspended
}

model BillingPlan {
  id                Int      @id @default(autoincrement())
  code              String   @unique @db.VarChar(32) // complimentary | starter | professional | enterprise
  name              String   @db.VarChar(64)
  priceMonthly      Int      @default(0) // minor units (paise/INR); 0 = complimentary/unlimited
  currency          String   @default("INR")
  maxStructures     Int? // projects owned by the admin; null = unlimited
  maxSensors        Int? // sensors assigned to the admin; null = unlimited
  maxUsers          Int? // contractor + authority members under the admin; null = unlimited
  dataRetentionDays Int?
  apiAccess         Boolean  @default(false)
  smsAlerts         Boolean  @default(false)
  aiFeatures        Boolean  @default(false)
  advancedReports   Boolean  @default(false)
  femIntegration    Boolean  @default(false)
  sso               Boolean  @default(false)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  subscriptions Subscription[]

  @@map("billing_plans")
}

model Subscription {
  id                     Int                @id @default(autoincrement())
  /// Identifiers at the payment provider. Null until checkout completes.
  providerCustomerId     String?            @db.VarChar(128)
  providerSubscriptionId String?            @unique @db.VarChar(128)
  /// End of the paid period. Access is governed by this plus any grace, not by
  /// the status column alone — a status can go stale if a webhook is missed.
  currentPeriodEnd       DateTime?
  /// When a failed payment stops being tolerated. Set on the first failure.
  gracePeriodEndsAt      DateTime?
  /// Set when cancellation is requested. The subscription runs to the end of
  /// the paid period rather than terminating immediately — the customer paid
  /// for it.
  cancelAtPeriodEnd      Boolean            @default(false)
  canceledAt             DateTime?
  /// The tenant is the billing entity. adminId is retained during the
  /// migration so existing billing queries keep working; it is removed once
  /// the subscription module reads tenantId.
  tenantId               Int?               @unique
  adminId                Int                @unique
  planId                 Int
  status                 SubscriptionStatus @default(trial)
  startsOn               DateTime           @default(now())
  renewsOn               DateTime?
  autoRenew              Boolean            @default(true)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  plan     BillingPlan @relation(fields: [planId], references: [id])
  tenant   Tenant?     @relation(fields: [tenantId], references: [id])
  admin    User        @relation(fields: [adminId], references: [id])
  invoices Invoice[]

  @@index([adminId])
  @@index([planId])
  @@map("subscriptions")
}

model Invoice {
  id                Int       @id @default(autoincrement())
  /// The provider's invoice id, when the invoice originated there. Unique, so
  /// a redelivered payment webhook cannot create a second invoice for the same
  /// charge.
  providerInvoiceId String?   @unique @db.VarChar(128)
  subscriptionId    Int
  invoiceNo         String    @unique @db.VarChar(32)
  periodStart       DateTime
  periodEnd         DateTime
  amountPaise       Int       @default(0)
  currency          String    @default("INR")
  status            String    @default("PAID") // PAID | OPEN
  paidAt            DateTime?
  createdAt         DateTime  @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId])
  @@map("invoices")
}

// ─── PAYMENT EVENTS ──────────────────────────────────────────────────────────

/// Every webhook received from the payment provider.
///
/// Two jobs. First, idempotency: providers retry aggressively and deliver
/// duplicates, so processing an event twice must not double-extend a
/// subscription or double-issue an invoice. The unique constraint on the
/// provider's own event id is what makes replay safe.
///
/// Second, evidence. Billing disputes are settled by what the provider
/// actually said and when, so the raw payload is kept rather than discarded
/// once parsed.
model PaymentEvent {
  id              Int    @id @default(autoincrement())
  provider        String @db.VarChar(32)
  /// The provider's event id. Unique, so a redelivery is rejected by the
  /// database rather than by application logic that could race.
  providerEventId String @db.VarChar(191)
  type            String @db.VarChar(120)

  /// Raw body as received, for dispute evidence and replay.
  payload Json

  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  /// Populated when handling failed, so a stuck event is diagnosable and can
  /// be retried deliberately rather than lost.
  error       String?   @db.Text

  subscriptionId Int?

  @@unique([provider, providerEventId])
  @@index([type, receivedAt])
  @@index([subscriptionId])
  @@map("payment_events")
}

// ─── AUDIT LOGS ─────────────────────────────────────────────────────────────

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(100)
  entityId  Int?
  oldValue  Json?
  newValue  Json?
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.Text
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── PROJECT INVITATIONS ─────────────────────────────────────────────────────
// Assigning a contractor or an authority used to mean an administrator creating
// the account outright and choosing that person's password for them. The
// password was therefore known to someone other than its owner from the moment
// the account existed, and the platform had no evidence the address it was
// typed against belonged to anybody.
//
// An invitation replaces that: the administrator names only an email, and the
// person on the other end proves they hold it and chooses their own secret.

enum InvitationStatus {
  pending
  accepted
  revoked
}

/// An offer of a project role to an email address.
///
/// The User row is created only on acceptance. A pending invitation therefore
/// cannot be mistaken for an account: user lists, seat counts and tenant
/// membership all stay free of half-built rows carrying placeholder names and
/// an unusable password hash.
model ProjectInvitation {
  id            Int       @id @default(autoincrement())
  projectId     Int
  /// Denormalised from the project ON PURPOSE. The tenant an invitee joins is
  /// fixed at the moment of invitation; reading it back through the project
  /// would let a project that later moves carry its outstanding invitations
  /// into an organization nobody agreed to.
  tenantId      Int
  /// contractor or authority. The enum has four values and the other two are
  /// rejected in the service, where the reason can be stated, rather than by a
  /// second enum that would have to be kept in step with UserRole.
  role          UserRole
  emailId       String    @db.VarChar(255)
  /// SHA-256 of the six-digit code, hashed for the same reason. A code that
  /// sits in the clear next to the address it was mailed to is not a factor.
  otpHash       String    @db.VarChar(128)
  /// Wrong guesses so far. The code is short by design, so the attempt cap —
  /// not the code's length — is what makes guessing impractical.
  otpAttempts   Int       @default(0)
  /// Set by the verify step. Completion refuses to run without it, so the
  /// profile-and-password call cannot be used to bypass the code.
  otpVerifiedAt DateTime?

  status     InvitationStatus @default(pending)
  expiresAt  DateTime
  acceptedAt DateTime?
  /// The user the invitation resolved to, once accepted. Kept for the record:
  /// Project.contractorId alone cannot say which invitation put them there.
  acceptedBy Int?
  invitedBy  Int
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  inviter User    @relation("InvitationInviter", fields: [invitedBy], references: [id])

  @@index([projectId, role, status])
  @@index([emailId])
  @@index([expiresAt])
  @@index([invitedBy])
  @@index([tenantId])
  @@map("project_invitations")
}
