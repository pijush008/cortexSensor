# Server
PORT=3001
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/shm?schema=public"

# JWT (REQUIRED IN PRODUCTION — generate with: openssl rand -hex 32)
JWT_SECRET=change-me-to-random-256-bit-hex
JWT_REFRESH_SECRET=change-me-to-random-256-bit-hex
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# IoT API key — sent by monitoring devices in header `x-api-key` to POST /api/beamDeviceData
# Generate with: openssl rand -hex 24
IOT_API_KEY=change-me-to-random-value

# MQTT (broker used by real devices; DO NOT reuse a production secret in dev)
# Used both for outbound republish AND for live device-to-cloud ingestion
# (ESP32 nodes / Raspberry Pi gateways publish here).
# Broker auth: the password lives in mosquitto/passwd (hashed). The mosquitto
# ACL restricts this user to  read shm/ingest/#  +  write shm/feed/#.
MQTT_BROKER_URL=ws://broker-address:9001
MQTT_USERNAME=shm-backend
MQTT_PASSWORD=shm-backend-pass

# Live IoT ingestion over MQTT (cloud side). The backend subscribes to these
# topics; every valid payload is stored via the same pipeline as POST /beamDeviceData.
MQTT_INGEST_ENABLED=true
# QUOTED deliberately: an unquoted '#' starts a comment in a .env file, so
# MQTT_INGEST_TOPICS=shm/ingest/# is read as "shm/ingest/" — the wildcard is
# silently dropped and the broker matches nothing the devices publish.
MQTT_INGEST_TOPICS="shm/ingest/#"
MQTT_INGEST_CLIENT_ID=shm-backend-ingest

# Email (Gmail SMTP — use an App Password, not the live account password)
GMAIL_ACCOUNT=your-email@gmail.com
GMAIL_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# CORS
ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.com

# Multi-factor authentication
# Platform operators (SUPER_ADMIN) must enrol in TOTP MFA (§94). Set to "false"
# only for a first-run deployment that has to create its initial operator
# before an authenticator app is available.
REQUIRE_MFA_FOR_PLATFORM_ADMINS=true

# Device ingest credentials
# Devices should authenticate with a per-device key issued at provisioning
# (header: x-device-key: <keyId>.<secret>). The fleet-wide IOT_API_KEY above is
# deprecated: it cannot be revoked for a single device and leaking it exposes
# every tenant's ingestion path. Set to false once no hardware depends on it.
ALLOW_LEGACY_INGEST_KEY=true

# Analysis engine and job queue
# Spectral estimation runs out of process (§74). ANALYSIS_WORKER_ENABLED=false
# in the API when a dedicated worker service runs the queue instead.
SHM_ENGINE_URL=http://localhost:8000
SHM_ENGINE_TIMEOUT_MS=60000
ANALYSIS_QUEUE_ENABLED=true
ANALYSIS_WORKER_ENABLED=true
ANALYSIS_WORKER_CONCURRENCY=2

# Billing
# The webhook verifies an HMAC-SHA256 signature over the raw request body.
# Without a secret the endpoint refuses (503) rather than accepting unsigned
# traffic. Checkout additionally requires a provider adapter.
BILLING_ENABLED=false
BILLING_WEBHOOK_SECRET=

# Development demo accounts (prisma/seed-demo-users.ts)
# Creates one login per role with a KNOWN password. The script refuses to run
# unless this is set, because it must never touch a production database.
ALLOW_DEMO_USERS=false

# Reverse proxies in front of the API. Determines which X-Forwarded-For entry
# is treated as the client, and therefore what rate limits are keyed on.
# Set to the number of proxies you actually operate; 0 when the API is exposed
# directly. Never trust the whole chain — a client can forge entries.
TRUST_PROXY_HOPS=1

# ── Payments (Razorpay) ──────────────────────────────────────────────────────
# BILLING_PROVIDER=razorpay switches the adapter on. Until then the generic
# HMAC adapter is used and checkout refuses rather than pretending to charge.
BILLING_PROVIDER=generic
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay signs webhooks with a secret you set in its dashboard. It is NOT the
# API key secret; verification fails silently-looking (401) if the two are swapped.
RAZORPAY_WEBHOOK_SECRET=

# Plan new organizations are placed on at sign-up, by CODE (see billing_plans).
# Change the PRICE by updating that row; this only selects which row.
DEFAULT_SIGNUP_PLAN=starter

# ── Google sign-in ───────────────────────────────────────────────────────────
# From Google Cloud Console → Credentials → OAuth 2.0 Client ID (Web).
# Authorised redirect URI must be exactly:
#   <APP_URL>/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where the frontend is served. Used for emailed links (password reset,
# verification) and for the Google redirect URI.
APP_URL=http://localhost:3000

# ── Outbound mail ────────────────────────────────────────────────────────────
# With none of these set NO mail is sent at all — registration verification and
# password reset links go nowhere, and accounts can never be verified.
#
# Gmail (the historical default; SMTP_HOST left unset):
#   GMAIL_ACCOUNT must be a full address, and GMAIL_PASSWORD must be a Google
#   APP PASSWORD (myaccount.google.com → Security → App passwords), NOT the
#   account password. Using the account password fails with EAUTH.
GMAIL_ACCOUNT=
GMAIL_PASSWORD=

# Any other provider (SendGrid, Mailgun, SES, a company mail server). Setting
# SMTP_HOST switches away from Gmail. Port 587 uses STARTTLS; set SMTP_SECURE
# to true only for port 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# The From address recipients see.
EMAIL_FROM=

# Redis. Optional: without it rate limiting falls back to in-memory, the
# analysis queue is disabled and SSE fan-out is single-process.
# Use a TCP endpoint (rediss:// for TLS) — BullMQ needs blocking commands,
# so a REST-only endpoint will not work.
REDIS_URL="rediss://default:PASSWORD@HOST:6379"

# Supabase Storage for uploaded images. Optional: without these, images are
# written to ./uploads, which cannot be shared between API instances.
# The service-role key bypasses RLS — server-side only, never in the client.
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR-SERVICE-ROLE-KEY"
SUPABASE_STORAGE_BUCKET="project_images"
