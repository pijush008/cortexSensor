# secrets - env reference file contains real credentials (JWT secret, Gmail)
env.text

# local env files
.env
.env.local
backend/.env
frontend/.env.local

# OS
.DS_Store

# node
node_modules/

# logs
logs/
*.log

# build output
# `.next*` (not just `.next/`) so quarantined copies such as a root-owned
# .next left behind by a container build are ignored too.
.next*
out/
dist/
build/
coverage/
*.tsbuildinfo

# Next.js scratch build directory (distDir override used during debugging)
frontend/tmp/

# Compiled output of prisma/seed.ts — the .ts file is the source of truth.
backend/prisma/seed.js
backend/prisma/seed.js.map
backend/prisma/seed.d.ts
backend/prisma/seed.d.ts.map

# Playwright MCP debugging artifacts (console logs / page snapshots)
.playwright-mcp/


# python (analysis engine)
*.pyc
__pycache__/
# Extracted legacy Flutter/PHP system (the platform being migrated FROM).
# 276MB including its own embedded git repositories — reference material, not
# part of this repository's history. The archive itself is also ignored.
flutter_version/
legacy-backup-*.tar.gz

# Visual brainstorming companion scratch files
.superpowers/

# Generated from proto/shm/engine/v1/engine.proto by the engine's entrypoint at
# container start. Deliberately not committed: a checked-in copy can disagree
# with the .proto it came from, and regenerating costs under a second.
python_shm_service/proto/engine_pb2.py
python_shm_service/proto/engine_pb2_grpc.py

# Production secrets: database password, Supabase service-role key, JWT secrets.
.env.prod

# TLS material for the production proxy. The private key must never be
# committed; the certificate is regenerated per environment anyway.
nginx/certs/*.pem
nginx/certbot/
